# Supabase Auth (browser + server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# Server-only — Settings → API Keys → Secret keys → + New secret key (sb_secret_…)
SUPABASE_SERVICE_ROLE_KEY=your-secret-key-here

# Comma-separated emails kept when running `npm run db:clean`
DEVELOPER_EMAIL_ALLOWLIST=you@example.com

# Prisma — Supabase Postgres connection strings
# Pooled (port 6543) for runtime queries:
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct (port 5432) for migrations:
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
